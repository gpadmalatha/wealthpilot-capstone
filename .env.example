# Copy this file to .env and fill in your own values. .env is git-ignored. Never commit real keys.
CAPSTONE_DOMAIN=wealthpilot

# Models (LiteLLM names). Swap providers by changing these two lines and the matching key below.
LLM_MODEL=gemini/gemini-flash-lite-latest
EMBEDDING_MODEL=gemini/gemini-embedding-001

# Provider key. Put the real value in .env only.
GEMINI_API_KEY=your-key-here

# Shared secret for the state-changing API endpoints (/underwrite and /decision).
# Leave empty to switch those endpoints off. Use a long random value.
API_KEY=
